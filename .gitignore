# ============================================================
# .gitignore -- iowa-fullstack-accessibility-portfolio
# Covers: .NET 10, ASP.NET MVC, EF Core, Node.js, Playwright,
#         axe-core, xUnit, Azure DevOps, VS / Rider IDEs
# ============================================================

# --- .NET build output --------------------------------------
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# --- .NET Core project files --------------------------------
project.lock.json
project.fragment.lock.json
*.nupkg
*.snupkg
*.binlog

# --- ASP.NET / EF Core --------------------------------------
ScaffoldingReadMe.txt
appsettings.Local.json
appsettings.*.Local.json

# --- .NET user secrets --------------------------------------
secrets.json
*.pfx
*.p12
*.pem

# --- Test results (xUnit / MSTest / NUnit) ------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
coverage/
CodeCoverage/
*.coveragexml
*.coverage
lcov.info

# --- Node.js (E2E + Accessibility test projects) ------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# --- Playwright ---------------------------------------------
playwright-report/
test-results/
.last-run.json
playwright/.cache/
blob-report/

# --- Environment variables ----------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production

# --- Visual Studio ------------------------------------------
.vs/
*.user
*.suo
*.userosscache
*.sln.ide
*.VC.db
*.VC.VC.opendb
*.sdf
*.opensdf
*.cachefile
*.aps
ipch/

# --- JetBrains Rider ----------------------------------------
.idea/
*.iml

# --- VS Code (uncomment to exclude workspace settings) ------
# .vscode/

# --- OS-generated files -------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Temporary / scratch files ------------------------------
~$*
*~
*.tmp
*.temp
.app-log.txt
.app-err.txt

# --- Azure DevOps / CI artefacts ----------------------------
drop/
publish/

# --- Kept intentionally (do NOT add to ignore) --------------
# accessibility-reports/axe-*.json  -- committed raw axe output
# accessibility-reports/*.md        -- committed human-readable summary
# pipeline/azure-pipelines.yml      -- committed CI/CD definition
# docs/                             -- committed architecture docs
