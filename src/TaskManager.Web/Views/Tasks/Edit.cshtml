@model TaskManager.Web.Models.TaskItemViewModel
@{
    ViewData["Title"] = $"Edit: {Model.Title}";
}

<nav aria-label="Breadcrumb" class="mb-2">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">My Tasks</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-warning py-3">
                <h1 class="h4 mb-0 text-dark">
                    <span class="material-icons align-middle me-2" aria-hidden="true">edit</span>
                    Edit Task
                </h1>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit"
                      method="post"
                      novalidate
                      aria-label="Edit task form"
                      id="editTaskForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />

                    <!-- Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">
                            Task Title <span class="text-danger" aria-hidden="true">*</span>
                        </label>
                        <input asp-for="Title"
                               class="form-control form-control-lg"
                               aria-required="true"
                               aria-describedby="editTitleError editTitleHint"
                               autofocus />
                        <div id="editTitleHint" class="form-text">Required. Between 3 and 200 characters.</div>
                        <span asp-validation-for="Title"
                              id="editTitleError"
                              class="invalid-feedback d-block"
                              aria-live="polite"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"
                                  aria-describedby="editDescError"></textarea>
                        <span asp-validation-for="Description"
                              id="editDescError"
                              class="invalid-feedback d-block"
                              aria-live="polite"></span>
                    </div>

                    <!-- Priority + Status -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold">Priority</label>
                            <select asp-for="Priority"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<TaskManager.Core.Entities.TaskPriority>()">
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold">Status</label>
                            <select asp-for="Status"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<TaskManager.Core.Entities.TaskStatus>()">
                            </select>
                        </div>
                    </div>

                    <!-- Due Date + Assigned To -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="DueDate" class="form-label fw-semibold">Due Date</label>
                            <input asp-for="DueDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CreatedBy" class="form-label fw-semibold">Assigned To</label>
                            <input asp-for="CreatedBy" class="form-control" />
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit"
                                class="btn btn-warning btn-lg text-dark"
                                aria-label="Save changes to this task">
                            <span class="material-icons align-middle me-1" aria-hidden="true">save</span>
                            Save Changes
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary btn-lg"
                           aria-label="Cancel and return to task details">
                            <span class="material-icons align-middle me-1" aria-hidden="true">cancel</span>
                            Cancel
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id"
                           class="btn btn-outline-danger btn-lg ms-auto"
                           aria-label="Delete this task">
                            <span class="material-icons align-middle me-1" aria-hidden="true">delete</span>
                            Delete
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
